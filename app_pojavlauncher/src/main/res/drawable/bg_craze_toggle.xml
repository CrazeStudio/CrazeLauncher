<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#1A10B981" />
            <stroke android:width="1dp" android:color="#10B981" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#161F30" />
            <stroke android:width="1dp" android:color="#26354A" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>
