<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#1A1A1A" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#FFFFFF" />
                </shape>
            </item>
            <item
                android:drawable="@drawable/ic_craze_chevron_down"
                android:gravity="end|center_vertical"
                android:width="18dp"
                android:height="18dp"
                android:end="12dp"
                android:right="12dp" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#141414" />
                    <stroke
                        android:width="1dp"
                        android:color="#2E2E2E" />
                </shape>
            </item>
            <item
                android:drawable="@drawable/ic_craze_chevron_down"
                android:gravity="end|center_vertical"
                android:width="18dp"
                android:height="18dp"
                android:end="12dp"
                android:right="12dp" />
        </layer-list>
    </item>
</selector>
