<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#12161D" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#10B981" />
                </shape>
            </item>
            <item
                android:drawable="@drawable/ic_craze_chevron_down"
                android:gravity="end|center_vertical"
                android:width="18dp"
                android:height="18dp"
                android:end="12dp"
                android:right="12dp" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#0B0E14" />
                    <stroke
                        android:width="1dp"
                        android:color="#1F252E" />
                </shape>
            </item>
            <item
                android:drawable="@drawable/ic_craze_chevron_down"
                android:gravity="end|center_vertical"
                android:width="18dp"
                android:height="18dp"
                android:end="12dp"
                android:right="12dp" />
        </layer-list>
    </item>
</selector>
