<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or not? -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="android:windowBackground">@color/background_app</item>
        <item name="preferenceTheme">@style/CrazePreferenceTheme</item>

        <item name="android:alertDialogTheme">@style/CrazeAlertDialogTheme</item>
        <item name="alertDialogTheme">@style/CrazeAlertDialogTheme</item>
        <item name="android:spinnerStyle">@style/CrazeSpinnerStyle</item>
        <item name="spinnerStyle">@style/CrazeSpinnerStyle</item>
        <item name="android:spinnerDropDownItemStyle">@style/CrazeSpinnerDropDownItem</item>
        <item name="spinnerDropDownItemStyle">@style/CrazeSpinnerDropDownItem</item>

        <item name="colorAccent">#FFFFFF</item>
        <item name="colorControlActivated">#4B5563</item>
        <item name="colorControlNormal">#8E98A5</item>
        <item name="colorControlHighlight">#26FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:editTextColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#8E98A5</item>

        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="CrazeAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_landscape_panel</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#8E98A5</item>
        <item name="colorAccent">#FFFFFF</item>
        <item name="buttonBarPositiveButtonStyle">@style/CrazeDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CrazeDialogButton.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/CrazeDialogButton</item>
    </style>

    <style name="CrazeDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="CrazeDialogButton.Negative" parent="CrazeDialogButton">
        <item name="android:textColor">#8E98A5</item>
    </style>

    <style name="CrazeSpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/bg_landscape_panel</item>
    </style>

    <style name="CrazeSpinnerDropDownItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="CrazePreferenceTheme" parent="@style/PreferenceThemeOverlay.v14.Material">
        <item name="preferenceCategoryStyle">@style/CrazePreferenceCategory</item>
        <item name="preferenceStyle">@style/CrazePreference</item>
        <item name="checkBoxPreferenceStyle">@style/CrazePreference.CheckBox</item>
        <item name="switchPreferenceCompatStyle">@style/CrazePreference.Switch</item>
        <item name="switchPreferenceStyle">@style/CrazePreference.Switch</item>
        <item name="seekBarPreferenceStyle">@style/CrazePreference.SeekBar</item>
        <item name="dialogPreferenceStyle">@style/CrazePreference</item>
        <item name="editTextPreferenceStyle">@style/CrazePreference</item>

        <item name="colorAccent">#10B981</item>
        <item name="colorControlActivated">#10B981</item>
        <item name="colorControlNormal">#8E98A5</item>
        <item name="colorControlHighlight">#2610B981</item>
    </style>

    <style name="CrazePreferenceCategory" parent="@style/Preference.Category">
        <item name="android:textColor">#10B981</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CrazePreference" parent="@style/Preference.Material">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#8E98A5</item>
    </style>

    <style name="CrazePreference.CheckBox" parent="@style/Preference.CheckBoxPreference.Material">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#8D9AA8</item>
    </style>

    <style name="CrazePreference.Switch" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#8D9AA8</item>
    </style>

    <style name="CrazePreference.SeekBar" parent="@style/Preference.SeekBarPreference.Material">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#8D9AA8</item>
    </style>

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
</resources>
