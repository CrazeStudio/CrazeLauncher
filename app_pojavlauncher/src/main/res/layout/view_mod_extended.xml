<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingTop="6dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/mod_extended_error_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_modpack_download_error"
        android:textColor="#E0E0E0"
        android:textSize="11sp"
        android:visibility="gone"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatSpinner
        android:id="@+id/mod_extended_version_spinner"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_craze_input"
        android:paddingHorizontal="6dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/mod_extended_select_version_button"
        app:layout_constraintTop_toBottomOf="@id/mod_extended_error_textview"
        app:layout_constraintBottom_toBottomOf="parent" />

    <Button
        android:id="@+id/mod_extended_select_version_button"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="84dp"
        android:enabled="false"
        android:text="@string/generic_install"
        android:textColor="@color/btn_install_text"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/bg_craze_install_btn"
        android:paddingHorizontal="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mod_extended_version_spinner"
        app:layout_constraintBottom_toBottomOf="@id/mod_extended_version_spinner" />

</androidx.constraintlayout.widget.ConstraintLayout>
