<?xml version="1.0" encoding="utf-8"?>
<fr.spse.extended_view.DefocusableScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_background"
    android:padding="16dp"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Card / Hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_craze_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instance Management"
                android:textColor="@color/primary_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage your Minecraft installations, modloaders, and active profiles."
                android:textColor="@color/secondary_text"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <!-- Web Link Card -->
            <LinearLayout
                android:id="@+id/web_link_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_craze_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_px_book"
                    app:tint="@color/primary_text"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Official Web Portal"
                        android:textColor="@color/primary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crazelauncher-steel.vercel.app"
                        android:textColor="#64B5F6"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_craze_chevron_right"
                    app:tint="@color/secondary_text"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Create New Instance Action Card -->
        <LinearLayout
            android:id="@+id/card_create_instance_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_craze_card_clickable"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_craze_add"
                android:background="@drawable/bg_craze_play_btn"
                android:padding="8dp"
                app:tint="@color/primary_text"
                android:contentDescription="@null"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create New Instance"
                    android:textColor="@color/primary_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Setup Vanilla, Forge, Fabric, NeoForge, Quilt or Modpacks"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/spinner_arrow_right"
                app:tint="@color/secondary_text"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Instances List Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Installed Instances"
            android:textColor="@color/primary_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Container for dynamic instance list items -->
        <LinearLayout
            android:id="@+id/instances_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</fr.spse.extended_view.DefocusableScrollView>
