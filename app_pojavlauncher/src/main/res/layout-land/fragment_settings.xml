<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0A0D14"
    android:padding="8dp">

    <!-- Left Sidebar: Category Deck (Fixed 240dp) with Frosted Glass -->
    <LinearLayout
        android:id="@+id/settings_sidebar"
        android:layout_width="230dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_landscape_panel"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:layout_marginEnd="8dp">

        <!-- Header: Back Button + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/btn_settings_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_craze_card_clickable"
                android:src="@drawable/ic_craze_back"
                android:contentDescription="Back"
                app:tint="#FFFFFF"
                android:padding="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETTINGS"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Graphics, controls &amp; runtime"
                    android:textColor="#8D9AA8"
                    android:textSize="9.5sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Category Items Scrollable Container -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categories_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Video & Renderer -->
                <LinearLayout
                    android:id="@+id/category_video"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/bg_craze_category_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:id="@+id/icon_video"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_px_image"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/text_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Video &amp; Renderer"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Control Settings -->
                <LinearLayout
                    android:id="@+id/category_controls"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/bg_craze_category_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:id="@+id/icon_controls"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_px_gamepad"
                        app:tint="#8D9AA8" />

                    <TextView
                        android:id="@+id/text_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Control Settings"
                        android:textColor="#8D9AA8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Java & Memory -->
                <LinearLayout
                    android:id="@+id/category_java"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/bg_craze_category_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:id="@+id/icon_java"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_px_java"
                        app:tint="#8D9AA8" />

                    <TextView
                        android:id="@+id/text_java"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Java &amp; Memory"
                        android:textColor="#8D9AA8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Miscellaneous -->
                <LinearLayout
                    android:id="@+id/category_misc"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/bg_craze_category_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:id="@+id/icon_misc"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_px_alt_sliders"
                        app:tint="#8D9AA8" />

                    <TextView
                        android:id="@+id/text_misc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Miscellaneous"
                        android:textColor="#8D9AA8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Experimental -->
                <LinearLayout
                    android:id="@+id/category_experimental"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/bg_craze_category_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:id="@+id/icon_experimental"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_px_experiment"
                        app:tint="#8D9AA8" />

                    <TextView
                        android:id="@+id/text_experimental"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Experimental"
                        android:textColor="#8D9AA8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Subtle Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_craze_card"
            android:padding="8dp"
            android:layout_marginTop="6dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_craze_status_online"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings auto-save on change"
                android:textColor="#8D9AA8"
                android:textSize="9.5sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Right Pane: Preference Content Container in Frosted Glass Panel -->
    <FrameLayout
        android:id="@+id/settings_content_frame"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_landscape_panel"
        android:padding="8dp" />

</LinearLayout>
