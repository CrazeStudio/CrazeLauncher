<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_craze_add"
                app:tint="@color/accent_green"
                android:contentDescription="@null"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create New Instance"
                    android:textColor="@color/primary_text"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select instance type and modloader ecosystem"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Landscape Grid Rows (2 Cards per Row) -->
        
        <!-- Row 1: Vanilla & Optifine -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/vanilla_profile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_craze_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_craze_logo"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_instance_vanilla"
                        android:textColor="@color/primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pure official release"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/spinner_arrow_right"
                    app:tint="@color/secondary_text"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/optifine_profile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_craze_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_px_zap"
                    app:tint="#F59E0B"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mod_dl_install_optifine"
                        android:textColor="@color/primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shaders &amp; graphics boost"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/spinner_arrow_right"
                    app:tint="@color/secondary_text"
                    android:contentDescription="@null"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Row 2: Fabric & Forge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/modded_profile_fabric"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_craze_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_fabric"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modloader_dl_install_fabric_instance"
                        android:textColor="@color/primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fast modern modloader"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/spinner_arrow_right"
                    app:tint="@color/secondary_text"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modded_profile_forge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_craze_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_forge"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modloader_dl_install_forge_instance"
                        android:textColor="@color/primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Classic modding platform"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/spinner_arrow_right"
                    app:tint="@color/secondary_text"
                    android:contentDescription="@null"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Row 3: NeoForge & Quilt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/modded_profile_neoforge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_craze_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_neoforge"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modloader_dl_install_neoforge_instance"
                        android:textColor="@color/primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modern evolution of Forge"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/spinner_arrow_right"
                    app:tint="@color/secondary_text"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modded_profile_quilt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_craze_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_quilt"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modloader_dl_install_quilt_instance"
                        android:textColor="@color/primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modular toolchain"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/spinner_arrow_right"
                    app:tint="@color/secondary_text"
                    android:contentDescription="@null"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Row 4: Modpack & Legacy Fabric -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/modded_profile_modpack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_craze_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_craze_modpack_folder"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modpack_install_instance_button"
                        android:textColor="@color/primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Browse Modrinth packs"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/spinner_arrow_right"
                    app:tint="@color/secondary_text"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modded_profile_legacy_fabric"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_craze_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_fabric"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modloader_dl_install_legacy_fabric_instance"
                        android:textColor="@color/primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fabric for older versions"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/spinner_arrow_right"
                    app:tint="@color/secondary_text"
                    android:contentDescription="@null"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Row 5: BTA Overhaul -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/modded_profile_bta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:background="@drawable/bg_craze_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_px_volcano"
                    app:tint="#EF4444"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_bta_instance"
                        android:textColor="@color/primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Better Than Adventure overhaul"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/spinner_arrow_right"
                    app:tint="@color/secondary_text"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </LinearLayout>
</com.kdt.DefocusableScrollView>
