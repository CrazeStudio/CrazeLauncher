<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_craze_sidebar"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_px_file_dl"
            app:tint="@color/primary_text"
            android:contentDescription="@null"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mcl_download_manager"
            android:textColor="@color/primary_text"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="12dp"/>

    <!-- Option 1: Download Versions -->
    <LinearLayout
        android:id="@+id/option_download_versions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_craze_card_clickable"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_craze_add"
            app:tint="@color/primary_text"
            android:contentDescription="@null"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mcl_download_versions"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Install Minecraft versions, modloaders, and modpacks"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/spinner_arrow_right"
            app:tint="@color/secondary_text"
            android:contentDescription="@null"/>
    </LinearLayout>

    <!-- Option 2: Browse Mods -->
    <LinearLayout
        android:id="@+id/option_browse_mods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_craze_card_clickable"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_craze_modpack_folder"
            android:contentDescription="@null"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mcl_browse_mods"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discover and install mods from Modrinth"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/spinner_arrow_right"
            app:tint="@color/secondary_text"
            android:contentDescription="@null"/>
    </LinearLayout>

    <!-- Option 3: Instance Editor -->
    <LinearLayout
        android:id="@+id/option_instance_editor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_craze_card_clickable"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_px_sliders"
            app:tint="@color/primary_text"
            android:contentDescription="@null"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mcl_instance_editor"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configure instance settings, memory, and controls"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/spinner_arrow_right"
            app:tint="@color/secondary_text"
            android:contentDescription="@null"/>
    </LinearLayout>

</LinearLayout>
