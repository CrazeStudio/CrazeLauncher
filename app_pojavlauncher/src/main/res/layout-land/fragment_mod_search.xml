<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp">

    <!-- Top Overlay: Search Bar + Filter + Type Filter Tabs -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_mod_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationZ="10dp"
        android:background="@drawable/bg_landscape_panel"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Search text input -->
        <EditText
            android:id="@+id/search_mod_edittext"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_craze_input"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/text_tertiary"
            android:textSize="13sp"
            android:hint="@string/hint_search_content"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:paddingHorizontal="14dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/search_mod_filter" />

        <ImageButton
            android:id="@+id/search_mod_filter"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_craze_edit_btn"
            android:src="@drawable/ic_filter"
            app:tint="@color/secondary_text"
            android:contentDescription="Filters"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/search_mod_edittext"
            app:layout_constraintTop_toTopOf="@id/search_mod_edittext"
            app:layout_constraintBottom_toBottomOf="@id/search_mod_edittext" />

        <!-- Category Filter Chips (Modpacks, Mods, Resource Packs, Shaders) -->
        <HorizontalScrollView
            android:id="@+id/category_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/search_mod_edittext"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chip_type_modpack"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Modpacks"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_craze_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_type_mod"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Mods"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_craze_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_type_resourcepack"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Resource Packs"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_craze_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_type_shader"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Shaders"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_craze_chip_unselected"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>

        <ProgressBar
            android:id="@+id/search_mod_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/category_scroll_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Mod List (2-column in landscape) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_mod_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/mineButton_import_local_modpack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/search_mod_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/secondary_text"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/search_mod_list"
        app:layout_constraintEnd_toEndOf="@+id/search_mod_list"
        app:layout_constraintStart_toStartOf="@+id/search_mod_list"
        app:layout_constraintTop_toTopOf="@+id/search_mod_list" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/mineButton_import_local_modpack"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:enabled="false"
        android:layout_marginBottom="8dp"
        android:text="@string/import_local_modpack"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
