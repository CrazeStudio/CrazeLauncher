<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0B0E14"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp"
    android:paddingTop="6dp">

    <!-- ======================================================== -->
    <!-- LEFT PANE: SIDEBAR NAVIGATION                            -->
    <!-- ======================================================== -->
    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_landscape_panel"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Tab: Home (Active) -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_landscape_active_tab"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="4dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_px_home"
                android:contentDescription="Home"
                app:tint="#FFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Home"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab: Instances -->
        <LinearLayout
            android:id="@+id/nav_instances"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="?selectableItemBackground"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="4dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_craze_cube"
                android:contentDescription="Instances"
                app:tint="#A4A8B0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Instances"
                android:textColor="#A4A8B0"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Tab: Mods -->
        <LinearLayout
            android:id="@+id/nav_mods"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="?selectableItemBackground"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="4dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_craze_folder"
                android:contentDescription="Mods"
                app:tint="#A4A8B0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Mods"
                android:textColor="#A4A8B0"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Tab: Packs -->
        <LinearLayout
            android:id="@+id/nav_packs"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="?selectableItemBackground"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="4dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_craze_layers"
                android:contentDescription="Packs"
                app:tint="#A4A8B0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Packs"
                android:textColor="#A4A8B0"
                android:textSize="13sp" />
        </LinearLayout>
        
        <!-- Flexible Spacer to push Settings to bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Tab: Settings -->
        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="?selectableItemBackground"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_px_sliders"
                android:contentDescription="Settings"
                app:tint="#A4A8B0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Settings"
                android:textColor="#A4A8B0"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- RIGHT PANE: MAIN CONTENT & CONTROLS                      -->
    <!-- ======================================================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_landscape_panel"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Row: Instance selector with icon and edit button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <!-- Grass Block Icon -->
            <ImageView
                android:id="@+id/grass_block"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_craze_grass_block"
                android:contentDescription="Instance" />

            <!-- Version Selector Dropdown -->
            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:drawableEnd="@drawable/spinner_arrow"
                app:drawableEndSize="@dimen/padding_heavy"
                app:drawableStartIntegerScaling="true" />

            <!-- Edit Instance Settings / JVM Button -->
            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_craze_edit_btn"
                android:src="@drawable/ic_craze_pencil"
                android:tint="#A4A8B0"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/create_instance" />
        </LinearLayout>

        <!-- Flexible Space above Play Button -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="4dp" />

        <!-- Middle: Big PLAY Button -->
        <FrameLayout
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_landscape_play"
            android:clickable="true"
            android:focusable="true">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_craze_play"
                        android:contentDescription="@null"
                        app:tint="#FFFFFF" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="PLAY"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="MINECRAFT JAVA EDITION"
                    android:textColor="#8E98A5"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom Row: 4 Quick Action Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <!-- Card 1: Mods -->
            <FrameLayout
                android:id="@+id/card_mods"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_landscape_card"
                android:clickable="true"
                android:focusable="true">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_craze_folder"
                        app:tint="#FFFFFF" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mods"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Install Mods"
                            android:textColor="#8E98A5"
                            android:textSize="7.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Card 2: Modpacks -->
            <FrameLayout
                android:id="@+id/card_modpacks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_landscape_card"
                android:clickable="true"
                android:focusable="true">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_craze_modpack_folder"
                        app:tint="#FFFFFF" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modpacks"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Browse Packs"
                            android:textColor="#8E98A5"
                            android:textSize="7.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Card 3: Custom Controls -->
            <FrameLayout
                android:id="@+id/custom_control_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_landscape_card"
                android:clickable="true"
                android:focusable="true">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_craze_palette"
                        app:tint="#FFFFFF" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Controls"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Custom Keys"
                            android:textColor="#8E98A5"
                            android:textSize="7.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Card 4: Install JAR -->
            <FrameLayout
                android:id="@+id/install_jar_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_landscape_card"
                android:clickable="true"
                android:focusable="true">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_craze_map"
                        app:tint="#FFFFFF" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Install JAR"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Forge / Fabric"
                            android:textColor="#8E98A5"
                            android:textSize="7.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Lowest Row: News Bar -->
        <LinearLayout
            android:id="@+id/news_button"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_landscape_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true">
            
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_craze_log_doc"
                app:tint="#FFFFFF" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginStart="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="News: "
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stay updated with the latest Minecraft and CrazeLauncher news!"
                    android:textColor="#8E98A5"
                    android:textSize="10sp"
                    android:ellipsize="end"
                    android:singleLine="true" />
            </LinearLayout>
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_craze_chevron_right"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Stubs to preserve all fragment and activity view-bindings safely -->
        <View android:id="@+id/open_files_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/share_logs_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/card_new_instance" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/card_mods_modpacks" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/social_media_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/ready_badge" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/instance_card_title" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
